# Swagger服务配置
# Swagger文档URL地址，多个地址用逗号分隔
SWAGGER_URLS=http://localhost:8080/v3/api-docs
# API调用地址，多个地址用逗号分隔，当此配置为空时使用SWAGGER_URLS中的地址
SWAGGER_API_SERVERS=
# 请求超时时间（秒）
SWAGGER_TIMEOUT=30.0
# 请求头，JSON格式字符串
SWAGGER_HEADERS={"Accept": "application/json"}
# Swagger工具前缀，用于生成工具名称
SWAGGER_TOOL_PREFIX=swagger_
